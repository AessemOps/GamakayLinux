# Maintainer: GamakayLinux contributors
# Arch/CachyOS package for GamakayLinux: the CLI, the iced GUI, the udev rule,
# the desktop entry and its icons.
#
# pkgver is kept in step with the workspace Cargo.toml version by
# scripts/check-release-version.sh; `make package-arch` builds it.

pkgname=gamakaylinux
pkgver=0.1.0
pkgrel=1
pkgdesc="Configure the GamaKay LK67 keyboard from Linux over USB"
# x86_64 only: nothing builds or verifies aarch64, and claiming it would ship a
# package no one has tested.
arch=('x86_64')
url="https://github.com/AessemOps/GamakayLinux"
license=('GPL-3.0-or-later')
# The GUI loads its display, input and GPU stack with dlopen at runtime, so none
# of it shows up in `ldd`: without these the packaged binary fails to start.
depends=('libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr'
         'vulkan-icd-loader' 'libglvnd' 'ttf-dejavu')
makedepends=('cargo' 'rust')
install="$pkgname.install"
# No split debug package: makepkg's `debug` option would emit
# $pkgname-debug alongside the package, and that is a distribution's job, not a
# release asset's.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# GitHub's archive extracts to the *repository* name, not $pkgname.
_archive="GamakayLinux-$pkgver"
# The v0.1.0 tag's tarball, as GitHub serves it. Note this is GitHub's own
# archive, not the one the release workflow synthesises for its CI build, so
# its hash has to come from the published tarball (`updpkgsums`, or
# `curl -L .../archive/v$pkgver.tar.gz | sha256sum`). Bump it with the version.
sha256sums=('600d86974cc39aa97bfa2632baf8c566287fa459451b569a96db40ac3586dbec')

prepare() {
  cd "$_archive"
  cargo fetch --locked
}

build() {
  cd "$_archive"
  cargo build --frozen --release --locked
}

package() {
  cd "$_archive"
  install -Dm755 target/release/gamakay "$pkgdir/usr/bin/gamakay"
  install -Dm755 target/release/gamakay-gui "$pkgdir/usr/bin/gamakay-gui"
  install -Dm644 packaging/udev/70-gamakay.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-gamakay.rules"
  install -Dm644 packaging/gamakay.desktop \
    "$pkgdir/usr/share/applications/gamakay.desktop"

  install -Dm644 packaging/io.github.aessemops.gamakaylinux.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.aessemops.gamakaylinux.metainfo.xml"

  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/gamakay.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/gamakay.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 CREDITS.md "$pkgdir/usr/share/licenses/$pkgname/CREDITS.md"
  # OFL-1.1 requires the licence to travel with the bundled emoji font.
  install -Dm644 crates/gamakay-gui/assets/NotoEmoji-OFL.txt \
    "$pkgdir/usr/share/licenses/$pkgname/NotoEmoji-OFL.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
